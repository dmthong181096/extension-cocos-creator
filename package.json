{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "remove-unused-asset",
    "version": "1.0.0",
    "author": "Cocos Creator",
    "editor": ">=3.8.8",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "npx tsc"
    },
    "description": "i18n:remove-unused-asset.description",
    "main": "./dist/main.js",
    "dependencies": {
        "fs-extra": "^10.0.0"
    },
    "devDependencies": {
        "@types/fs-extra": "^9.0.5",
        "@types/node": "^18.17.1",
        "typescript": "^5.8.2"
    },
    "panels": {
        "default": {
            "title": "Remove Unused Assets",
            "type": "dockable",
            "main": "dist/panels/default",
            "size": {
                "min-width": 600,
                "min-height": 400,
                "width": 1024,
                "height": 700
            }
        }
    },
    "contributions": {
        "menu": [
            {
                "path": "i18n:menu.panel/remove-unused-asset",
                "label": "i18n:remove-unused-asset.open_panel",
                "message": "open-panel"
            },
            {
                "path": "i18n:menu.extension/remove-unused-asset",
                "label": "i18n:remove-unused-asset.open_panel",
                "message": "open-panel"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "scan-assets": {
                "methods": [
                    "scanAssets"
                ]
            },
            "delete-assets": {
                "methods": [
                    "deleteAssets"
                ]
            }
        }
    }
}
